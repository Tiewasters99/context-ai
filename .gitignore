# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.local
# Any other .env variant - notably the dated pre-revocation backups
# (.env.bak-2026-07-31). These hold live-format API keys and were NOT
# matched by the two lines above, so `git add -A` would have committed
# them straight into history.
.env.*
!.env.example

# Vercel project link (created by `vercel` CLI on first deploy)
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local working copies of source documents (the canonical copies live in
# Supabase Storage and the documents/passages tables). Keeps the user's
# unpublished IP — screenplays, drafts, books being ingested — out of a
# public repo.
screenplays/
drafts/
books/

# bulk-import ledgers (local run state, per-machine)
.import-state/

# Claude Code per-clone state (permissions, agent worktrees) and the Tesseract
# language cache that tesseract.js drops in the working directory.
.claude/settings.local.json
.claude/worktrees/
*.traineddata
