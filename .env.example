VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Equazia.ai Student Hub <invites@contextspaces.ai>

# ── The site's public address (lib/site.mjs, src/lib/site.ts) ─────────────
# Empty = https://www.contextspaces.ai, the current domain. Moving the product
# to a new domain is these two lines (same value, no trailing slash) plus a
# redeploy. Register the new OAuth redirect URIs (Google, Microsoft, Dropbox)
# BEFORE setting them: every redirect URI the server sends follows SITE_ORIGIN.
# SITE_ORIGIN also sets where Stripe Checkout returns to.
SITE_ORIGIN=
VITE_SITE_ORIGIN=

# The Office — the auth.users uuid of the ONE owner whose published office is
# public at /api/office and /read/<item id>. Unset or malformed = the office is
# closed (503) and nothing is served. See docs/OFFICE_PUBLIC_ROOM.md
OFFICE_DEFAULT_OWNER_ID=

# ── Billing (migration 067) ────────────────────────────────────────────────
# Everything below is DORMANT until STRIPE_SECRET_KEY is set: every
# /api/billing-* endpoint answers 503 billing_not_configured and Settings →
# Billing renders a quiet "Billing is not yet enabled" line. The merchant is
# Grapheon.ai, LLC — never Quainton Law.
#
# Put the real values in .env FIRST, then in Vercel (Production). Test-mode
# keys start sk_test_ and charge nothing.
STRIPE_SECRET_KEY=PASTE
# From the Stripe dashboard's webhook endpoint (Developers → Webhooks →
# the endpoint → "Signing secret"). Starts whsec_.
STRIPE_WEBHOOK_SECRET=PASTE
#
# Price ids are OPTIONAL here: the preferred home is
# public.billing_plans.stripe_price_id / public.billing_credit_packs.stripe_price_id,
# which Eden edits in the SQL editor with no redeploy. These env vars are the
# fallback the code uses when the row is empty. The suffix is the row's key,
# upper-cased.
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_MAX=price_...
# STRIPE_PRICE_PACK_25=price_...
# STRIPE_PRICE_PACK_100=price_...
# STRIPE_PRICE_PACK_500=price_...
#
# Where Checkout returns to: SITE_ORIGIN (set near the top of this file).
# Unset, the host the request came in on is used.

# ── OneDrive and Dropbox export (migration 075) ────────────────────────────
# DORMANT until these are set. With them absent, /api/microsoft-connect,
# /api/dropbox-connect and /api/cloud-export all answer 503 not_configured,
# and the two Connections cards say "Not available yet" with the button
# disabled. Nothing else in the app changes; Google Drive export is untouched.
#
# Put the real values in .env FIRST, then in Vercel (Production).
#
# Microsoft Entra ID app registration → Certificates & secrets / Overview.
# Redirect URI (type Web): https://www.contextspaces.ai/api/microsoft-callback
# Delegated Microsoft Graph permission: Files.ReadWrite.AppFolder + offline_access
# (plus openid, email). NEVER Files.ReadWrite — that is the whole drive.
# ⚠ An Entra client secret EXPIRES (Google's does not). Note the expiry date.
MS_OAUTH_CLIENT_ID=PASTE
MS_OAUTH_CLIENT_SECRET=PASTE
# `common` accepts work/school and personal Microsoft accounts. Set a tenant
# id here to pin it to one organisation.
MS_OAUTH_TENANT=common
#
# Dropbox App Console → the app's Settings tab (App key / App secret).
# Permission type: App folder — NOT Full Dropbox (it cannot be changed later;
# the app has to be recreated). Permissions tab: files.content.write only.
# Redirect URI: https://www.contextspaces.ai/api/dropbox-callback
DROPBOX_APP_KEY=PASTE
DROPBOX_APP_SECRET=PASTE

# Bedrock pen — invoke-only IAM user; mode none must be set per Region (docs/BEDROCK_CLAUDE_PEN_SETUP.md)
BEDROCK_AWS_ACCESS_KEY_ID=PASTE
BEDROCK_AWS_SECRET_ACCESS_KEY=PASTE
BEDROCK_REGION=us-east-1
# BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1   # default since 2026-10-20 (classic runtime, invoke route). Leave UNSET in prod so the default applies.
#   moonshotai.kimi-k2.5 → the old default (mantle chat route); anthropic.claude-opus-5 → mantle Messages route once AWS lifts the Claude 5 gate

# Grapheon Reader merch (Phase 2b): Grapheon.ai LLC's own Stripe account (D3) and the Printify shop.
# Dormant until set: api/merch.mjs answers 503 merch_not_configured.
GRAPHEON_STRIPE_SECRET_KEY=PASTE
GRAPHEON_STRIPE_WEBHOOK_SECRET=PASTE
GRAPHEON_STRIPE_TAX=0
PRINTIFY_API_TOKEN=PASTE
PRINTIFY_SHOP_ID=25109380
# 0 = Printify orders wait on hold (the test loop); 1 = they print.
MERCH_SEND_TO_PRODUCTION=0
