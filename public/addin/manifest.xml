<?xml version="1.0" encoding="UTF-8"?>
<!--
  Equazia for Word: the task-pane add-in (docs/specs/WORD-ADDIN-2026-11-01.md).
  Sideload this file in Word (Add-ins > More Add-ins > My Add-ins > Upload My
  Add-in), or deploy it from the Microsoft 365 admin center. The pane itself is
  served from https://www.equazia.ai/addin.

  WordApi 1.4 is the requirement (Word 2021 and Microsoft 365, on Windows,
  Mac and the web). The pane is a modern bundle that the webviews of Word
  2016/2019 cannot run, and 1.4 is what "Add a Word comment" (insertComment)
  and the custom-property tag (1.3) need; declaring it keeps those older
  hosts from offering the add-in at all (AppSource policy 1120.3: it must
  work on every host that meets the declared set). The run-time checks in
  office.ts stay as belt and braces.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>b0260b0e-fcca-41bf-b897-35fc551e5a21</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Equazia.ai, Inc.</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Equazia" />
  <Description DefaultValue="Equazia inside Word: save the document to its matter as a version, and confirm every citation against the matter." />
  <IconUrl DefaultValue="https://www.equazia.ai/addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://www.equazia.ai/addin/icon-64.png" />
  <SupportUrl DefaultValue="https://www.equazia.ai/support" />
  <AppDomains>
    <AppDomain>https://www.equazia.ai</AppDomain>
    <AppDomain>https://equazia.ai</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.4" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://www.equazia.ai/addin" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.Url" />
          </GetStarted>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Equazia.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="Equazia.ConfirmButton">
                  <Label resid="Confirm.Label" />
                  <Supertip>
                    <Title resid="Confirm.Label" />
                    <Description resid="Confirm.Tip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Equazia.Pane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://www.equazia.ai/addin/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://www.equazia.ai/addin/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://www.equazia.ai/addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://www.equazia.ai/addin" />
        <bt:Url id="GetStarted.Url" DefaultValue="https://www.equazia.ai" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Equazia" />
        <bt:String id="Confirm.Label" DefaultValue="Equazia" />
        <bt:String id="GetStarted.Title" DefaultValue="Equazia is ready" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Confirm.Tip" DefaultValue="Open the Equazia pane: Save to Equazia stores this document in its matter as a version; Confirm this brief checks every citation against the matter." />
        <bt:String id="GetStarted.Description" DefaultValue="On the Home tab, press Equazia. Sign in, choose the matter, Save to Equazia, and Confirm this brief when you are ready." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
